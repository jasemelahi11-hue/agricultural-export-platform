from fastapi import FastAPI, HTTPException
from fastapi.responses import HTMLResponse
from pydantic import BaseModel
from typing import List

app = FastAPI(
    title="AgTech Enterprise Lite",
    version="3.1.0",
    description="پلتفرم جامع زنجیره تامین محصولات استراتژیک (انجیر، خرما، زعفران)"
)

# مدل داده پیشرفته منطبق بر استانداردهای لجستیک و تامین مالی
class AgriculturalItem(BaseModel):
    product_name: str  # انحصاری: انجیر، خرما، زعفران
    grade: str         # درجه کیفی (صادراتی، درجه یک)
    quantity_kg: float
    unit_price_irr: float
    farmer_name: str
    region: str        # منطقه کشت
    financing_required: bool = False  # الگوبرداری از ProducePay
    delivery_type: str  # مقصد داخلی یا صادراتی

# دیتابیس موقت حافظه داخلی
platform_database = []

# ارائه صفحه گرافیکی پیشرفته به عنوان صفحه اصلی
@app.get("/", response_class=HTMLResponse)
def serve_frontend():
    try:
        with open("index.html", "r", encoding="utf-8") as f:
            return f.read()
    except FileNotFoundError:
        return "<h3>فایل index.html در پوشه پروژه یافت نشد. لطفا آن را ایجاد کنید.</h3>"

# اندپوینت ثبت و بهینه‌سازی محصول
@app.post("/api/v1/products/", response_model=AgriculturalItem)
def register_and_optimize_product(item: AgriculturalItem):
    allowed_products = ["انجیر", "خرما", "زعفران"]
    
    if item.product_name not in allowed_products:
        raise HTTPException(
            status_code=400,
            detail="خطای انحصار محصول: پلتفرم صرفاً مختص مدیریت انجیر، خرما و زعفران است."
        )
    
    platform_database.append(item)
    return item

# اندپوینت دریافت لیست محصولات جهت نمایش در رابط کاربری
@app.get("/api/v1/products/", response_model=List[AgriculturalItem])
def get_all_products():
    return platform_database

